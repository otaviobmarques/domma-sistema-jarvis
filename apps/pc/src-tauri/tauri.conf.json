{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jarvis",
  "version": "0.1.0",
  "identifier": "br.com.dommasistemas.jarvis",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Jarvis by Domma Tecnologia",
        "width": 440,
        "height": 640,
        "minWidth": 380,
        "minHeight": 520,
        "resizable": true,
        "center": true,
        "visible": true,
        "alwaysOnTop": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Domma Tecnologia",
    "shortDescription": "Jarvis — assistente de IA da Domma",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "windows": {
      "nsis": {
        "languages": ["PortugueseBR"],
        "installMode": "currentUser"
      }
    }
  }
}
