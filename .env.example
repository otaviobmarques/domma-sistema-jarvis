# ---------------------------------------------------------------- Cérebro (apps/brain)
# Banco (Supabase, usuário restrito jarvis_backend). Pode listar várias URLs separadas por vírgula.
DATABASE_URL=postgresql://jarvis_backend.<ref>:<senha>@aws-1-sa-east-1.pooler.supabase.com:5432/postgres
BRAIN_API_SECRET=            # segredo compartilhado com o painel (openssl rand -hex 32)
ENCRYPTION_KEY=              # 64 caracteres hex (openssl rand -hex 32) — criptografa tokens e a sessão do WhatsApp
ANTHROPIC_API_KEY=           # chave da API do Claude
PUBLIC_URL=https://jarvis.dommasistemas.com.br   # usado no callback OAuth do Google
PANEL_URL=https://jarvis.dommasistemas.com.br

# Opcionais
MODEL_FAST=claude-haiku-5-5
MODEL_STRONG=claude-opus-5-5
USD_BRL=5.5
WHATSAPP_ENABLED=true
WHATSAPP_GROUPS=false
STT_API_KEY=                 # transcrição de áudio (Groq Whisper por padrão)
STT_URL=https://api.groq.com/openai/v1/audio/transcriptions
STT_MODEL=whisper-large-v3-turbo
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
META_ACCESS_TOKEN=           # alternativa a cadastrar o token no painel

# ---------------------------------------------------------------- Painel (apps/panel)
# DATABASE_URL, BRAIN_API_SECRET e USD_BRL iguais aos do cérebro
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
BRAIN_URL=http://brain.railway.internal:8080
